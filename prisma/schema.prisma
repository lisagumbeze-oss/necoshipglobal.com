generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  INDIVIDUAL
  BUSINESS
  ENTERPRISE
}

enum UserRole {
  CUSTOMER
  ADMIN
  OPS_MANAGER
  SUPPORT_AGENT
  FINANCE
  CUSTOMS_OFFICER
  READ_ONLY
  DRIVER
}

enum OrgMemberRole {
  ORG_ADMIN
  SHIPPER
  BILLING
  VIEWER
}

enum ShipmentStatus {
  DRAFT
  QUOTED
  BOOKED
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  CUSTOMS_HOLD
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  CANCELLED
  RETURNED
}

enum ServiceType {
  EXPRESS_AIR
  ECONOMY_AIR
  OCEAN
  GROUND
  LAST_MILE
}

enum PackageType {
  ENVELOPE
  BOX
  PALLET
  CONTAINER
  CUSTOM
}

enum InvoiceStatus {
  DRAFT
  DUE
  PAID
  OVERDUE
  VOID
  REFUNDED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum DocumentType {
  COMMERCIAL_INVOICE
  CUSTOMS_FORM
  BILL_OF_LADING
  DELIVERY_CONFIRMATION
  CERTIFICATE_OF_ORIGIN
  SHIPPING_LABEL
  PROOF_OF_DELIVERY
  CLAIM_EVIDENCE
  OTHER
}

enum ExceptionType {
  LOST_PACKAGE
  CUSTOMS_HOLD
  DELIVERY_FAILURE
  ADDRESS_ISSUE
  DAMAGE_REPORTED
  CARRIER_DELAY
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DENIED
  PAID
}

enum NotificationCategory {
  SHIPMENT_UPDATES
  BILLING
  SYSTEM
  PROMOTIONS
}

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  emailVerifiedAt   DateTime?
  passwordHash      String?
  name              String?
  phone             String?
  country           String?
  timezone          String       @default("UTC")
  language          String       @default("en")
  image             String?
  role              UserRole     @default(CUSTOMER)
  accountType       AccountType  @default(INDIVIDUAL)
  twoFactorEnabled  Boolean      @default(false)
  twoFactorSecret   String?
  backupCodes       String[]     @default([])
  companyName       String?
  ein               String?
  duns              String?
  creditLimitCents  Int?
  walletBalanceCents Int         @default(0)
  autoPayEnabled    Boolean      @default(false)
  preferredUnits    String       @default("metric")
  stripeCustomerId  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  sessions          Session[]
  accounts          Account[]
  verificationTokens VerificationToken[]
  organizations     OrganizationMember[]
  addresses         Address[]
  shipments         Shipment[]           @relation("ShipmentOwner")
  quotes            Quote[]
  invoices          Invoice[]
  payments          Payment[]
  documents         Document[]
  tickets           Ticket[]             @relation("TicketRequester")
  assignedTickets   Ticket[]             @relation("TicketAssignee")
  ticketMessages    TicketMessage[]
  notifications     Notification[]
  apiKeys           ApiKey[]
  webhookEndpoints  WebhookEndpoint[]
  auditLogs         AuditLog[]
  claims            Claim[]
  staffProfile      StaffProfile?
  driverProfile     DriverProfile?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  userAgent    String?
  ipAddress    String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String?
  identifier String
  token     String   @unique
  type      String   // email_verify | password_reset | otp
  expires   DateTime
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([identifier, token])
}

model Organization {
  id               String   @id @default(cuid())
  name             String
  accountType      AccountType @default(BUSINESS)
  creditLimitCents Int?
  billingEmail     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  members          OrganizationMember[]
  addresses        Address[]
  shipments        Shipment[]
  costCenters      CostCenter[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           OrgMemberRole @default(SHIPPER)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model CostCenter {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  name           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipments      Shipment[]

  @@unique([organizationId, code])
}

model Address {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  name           String
  company        String?
  phone          String?
  email          String?
  line1          String
  line2          String?
  city           String
  state          String?
  postalCode     String
  country        String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipmentsFrom  Shipment[]    @relation("OriginAddress")
  shipmentsTo    Shipment[]    @relation("DestinationAddress")
}

model Quote {
  id               String      @id @default(cuid())
  userId           String?
  originCountry    String
  originCity       String
  destCountry      String
  destCity         String
  packageType      PackageType
  weightKg         Float
  lengthCm         Float?
  widthCm          Float?
  heightCm         Float?
  declaredValueCents Int?
  commodity        String?
  quantity         Int         @default(1)
  selectedService  ServiceType?
  amountCents      Int?
  currency         String      @default("USD")
  carrierQuoteJson Json?
  dutyTaxEstimateCents Int?
  carbonKg         Float?
  expiresAt        DateTime?
  saved            Boolean     @default(false)
  createdAt        DateTime    @default(now())

  user             User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  shipment         Shipment?
}

model Shipment {
  id                 String         @id @default(cuid())
  trackingNumber     String         @unique
  userId             String?
  organizationId     String?
  costCenterId       String?
  quoteId            String?        @unique
  status             ShipmentStatus @default(DRAFT)
  serviceType        ServiceType    @default(EXPRESS_AIR)
  carrier            String?
  carrierShipmentId  String?
  originAddressId    String?
  destinationAddressId String?
  recipientName      String?
  recipientPhone     String?
  recipientEmail     String?
  deliveryInstructions String?
  weightKg           Float?
  lengthCm           Float?
  widthCm            Float?
  heightCm           Float?
  declaredValueCents Int?
  commodity          String?
  hsCode             String?
  incoterms          String?
  insuranceCents     Int?
  amountCents        Int?
  currency           String         @default("USD")
  promoCode          String?
  labelUrl           String?
  labelZpl           String?
  eta                DateTime?
  pickedUpAt         DateTime?
  deliveredAt        DateTime?
  recipientToken     String?        @unique
  isReturn           Boolean        @default(false)
  parentShipmentId   String?
  templateName       String?
  carbonKg           Float?
  hazmat             Boolean        @default(false)
  batteries          Boolean        @default(false)
  liquids            Boolean        @default(false)
  signatureRequired  Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user               User?          @relation("ShipmentOwner", fields: [userId], references: [id], onDelete: SetNull)
  organization       Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  costCenter         CostCenter?    @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  quote              Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  originAddress      Address?       @relation("OriginAddress", fields: [originAddressId], references: [id], onDelete: SetNull)
  destinationAddress Address?       @relation("DestinationAddress", fields: [destinationAddressId], references: [id], onDelete: SetNull)
  parentShipment     Shipment?      @relation("ReturnOf", fields: [parentShipmentId], references: [id], onDelete: SetNull)
  returns            Shipment[]     @relation("ReturnOf")

  packages           Package[]
  events             TrackingEvent[]
  documents          Document[]
  exceptions         Exception[]
  tickets            Ticket[]
  claims             Claim[]
  pickup             Pickup?
  customsClearance   CustomsClearance?
  proofOfDelivery    ProofOfDelivery?
  invoiceItems       InvoiceItem[]
}

model Package {
  id          String      @id @default(cuid())
  shipmentId  String
  packageType PackageType @default(BOX)
  weightKg    Float
  lengthCm    Float?
  widthCm     Float?
  heightCm    Float?
  description String?
  shipment    Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model TrackingEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus?
  code        String?
  description String
  location    String?
  lat         Float?
  lng         Float?
  occurredAt  DateTime @default(now())
  rawJson     Json?
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

model ProofOfDelivery {
  id           String   @id @default(cuid())
  shipmentId   String   @unique
  signedBy     String?
  signatureUrl String?
  photoUrl     String?
  notes        String?
  capturedAt   DateTime @default(now())
  shipment     Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model Exception {
  id          String        @id @default(cuid())
  shipmentId  String
  type        ExceptionType
  priority    Int           @default(2)
  notes       String?
  assignedTo  String?
  resolvedAt  DateTime?
  slaDeadline DateTime?
  createdAt   DateTime      @default(now())
  shipment    Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model CustomsClearance {
  id            String   @id @default(cuid())
  shipmentId    String   @unique
  status        String   @default("DOCS_PENDING")
  brokerNotes   String?
  docsChecklist Json?
  clearedAt     DateTime?
  updatedAt     DateTime @updatedAt
  shipment      Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model Pickup {
  id              String   @id @default(cuid())
  shipmentId      String   @unique
  scheduledStart  DateTime
  scheduledEnd    DateTime
  driverId        String?
  status          String   @default("SCHEDULED")
  carrierPickupId String?
  addressSnapshot Json?
  createdAt       DateTime @default(now())
  shipment        Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  driver          DriverProfile? @relation(fields: [driverId], references: [id], onDelete: SetNull)
}

model DriverProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  region    String?
  status    String   @default("OFF_DUTY")
  rating    Float?
  lat       Float?
  lng       Float?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pickups   Pickup[]
}

model StaffProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  department  String?
  permissions String[] @default([])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RateCard {
  id            String      @id @default(cuid())
  name          String
  originZone    String
  destZone      String
  serviceType   ServiceType
  carrier       String?
  weightMinKg   Float
  weightMaxKg   Float
  baseCents     Int
  perKgCents    Int         @default(0)
  currency      String      @default("USD")
  effectiveFrom DateTime    @default(now())
  effectiveTo   DateTime?
  organizationId String?
  createdAt     DateTime    @default(now())
}

model Surcharge {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  amountCents Int?
  percentBps  Int?
  active      Boolean  @default(true)
}

model PromoCode {
  id              String    @id @default(cuid())
  code            String    @unique
  description     String?
  percentOff      Int?
  amountOffCents  Int?
  freeService     Boolean   @default(false)
  maxUses         Int?
  usedCount       Int       @default(0)
  eligibleServices ServiceType[]
  expiresAt       DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique
  userId         String
  status         InvoiceStatus @default(DUE)
  amountCents    Int
  currency       String        @default("USD")
  dueAt          DateTime?
  paidAt         DateTime?
  pdfUrl         String?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          InvoiceItem[]
  payments       Payment[]
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  shipmentId  String?
  description String
  amountCents Int
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  shipment    Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  invoiceId         String?
  amountCents       Int
  currency          String   @default("USD")
  method            String
  stripePaymentId   String?
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice           Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}

model Document {
  id          String       @id @default(cuid())
  userId      String?
  shipmentId  String?
  type        DocumentType
  filename    String
  url         String
  mimeType    String?
  sizeBytes   Int?
  createdAt   DateTime     @default(now())
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  shipment    Shipment?    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model Ticket {
  id          String       @id @default(cuid())
  number      String       @unique
  userId      String
  assigneeId  String?
  shipmentId  String?
  subject     String
  status      TicketStatus @default(OPEN)
  priority    Int          @default(2)
  csatScore   Int?
  firstResponseAt DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation("TicketRequester", fields: [userId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  shipment    Shipment?    @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  messages    TicketMessage[]
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String?
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  category  NotificationCategory
  title     String
  message   String
  href      String?
  read      Boolean              @default(false)
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id        String  @id @default(cuid())
  userId    String
  eventType String
  email     Boolean @default(true)
  sms       Boolean @default(false)
  push      Boolean @default(true)

  @@unique([userId, eventType])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String
  prefix     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  userId    String
  url       String
  secret    String
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  endpointId String
  event      String
  payload    Json
  statusCode Int?
  success    Boolean  @default(false)
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Claim {
  id             String      @id @default(cuid())
  number         String      @unique
  shipmentId     String
  userId         String
  type           String
  description    String
  amountCents    Int?
  status         ClaimStatus @default(SUBMITTED)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  shipment       Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String
  category    String?
  authorName  String?
  coverUrl    String?
  seoTitle    String?
  seoDescription String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WarehouseLocation {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  createdAt DateTime @default(now())
  bins      WarehouseBin[]
  movements WarehouseMovement[]
}

model WarehouseBin {
  id         String @id @default(cuid())
  locationId String
  code       String
  location   WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  inventory  InventoryItem[]

  @@unique([locationId, code])
}

model InventoryItem {
  id       String @id @default(cuid())
  binId    String
  sku      String
  name     String
  quantity Int    @default(0)
  bin      WarehouseBin @relation(fields: [binId], references: [id], onDelete: Cascade)

  @@unique([binId, sku])
}

model WarehouseMovement {
  id         String   @id @default(cuid())
  locationId String
  sku        String?
  trackingNumber String?
  direction  String
  quantity   Int      @default(1)
  notes      String?
  createdAt  DateTime @default(now())
  location   WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model CarrierIntegration {
  id           String   @id @default(cuid())
  carrier      String   @unique
  status       String   @default("UNKNOWN")
  lastCheckedAt DateTime?
  latencyMs    Int?
  errorMessage String?
  meta         Json?
}

model CarrierInvoice {
  id            String   @id @default(cuid())
  carrier       String
  invoiceNumber String
  amountCents   Int
  currency      String   @default("USD")
  periodStart   DateTime?
  periodEnd     DateTime?
  fileUrl       String?
  matched       Boolean  @default(false)
  varianceCents Int?
  createdAt     DateTime @default(now())
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String   @default("info")
  source    String
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
