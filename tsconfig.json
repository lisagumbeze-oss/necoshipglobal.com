{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-prod/types/**/*.ts",
    ".next-prod-m5/types/**/*.ts",
    ".next-prod-m63a/types/**/*.ts",
    ".next-prod-m63gc/types/**/*.ts",
    ".next-prod-ui1/types/**/*.ts",
    ".next-prod-ui2/types/**/*.ts",
    ".next-prod-ui3/types/**/*.ts",
    ".next-prod-ui4/types/**/*.ts",
    ".next-prod-ui5/types/**/*.ts",
    ".next-prod-ui6/types/**/*.ts",
    ".next-prod-ui7/types/**/*.ts",
    ".next-prod-phase9/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tests",
    "vitest.config.ts"
  ]
}
